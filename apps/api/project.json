{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --project tsconfig.app.json",
        "cwd": "apps/api"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "npx ts-node -r tsconfig-paths/register apps/api/src/main.ts"
      }
    },
    "test": {
      "options": { "passWithNoTests": true }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx jest --config apps/api/e2e/jest-e2e.config.ts",
        "cwd": "."
      }
    }
  }
}
