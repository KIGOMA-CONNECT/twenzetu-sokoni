{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@abms/kernel": ["./libs/kernel/src/index.ts"],
      "@abms/core-config": ["./libs/core/config/src/index.ts"],
      "@abms/core-logger": ["./libs/core/logger/src/index.ts"],
      "@abms/core-http": ["./libs/core/http/src/index.ts"],
      "@abms/core-exceptions": ["./libs/core/exceptions/src/index.ts"],
      "@abms/core-security": ["./libs/core/security/src/index.ts"],
      "@abms/tenancy": ["./libs/tenancy/src/index.ts"],
      "@abms/database": ["./libs/database/src/index.ts"],
      "@abms/audit": ["./libs/audit/src/index.ts"],
      "@abms/cqrs": ["./libs/cqrs/src/index.ts"],
      "@abms/workflow-domain": ["./libs/workflow/domain/src/index.ts"],
      "@abms/workflow-infrastructure": [
        "./libs/workflow/infrastructure/src/index.ts"
      ],
      "@abms/workflow-application": [
        "./libs/workflow/application/src/index.ts"
      ],
      "@abms/workflow-api": ["./libs/workflow/api/src/index.ts"],
      "@abms/organization-domain": ["./libs/organization/domain/src/index.ts"],
      "@abms/organization-infrastructure": [
        "./libs/organization/infrastructure/src/index.ts"
      ],
      "@abms/organization-application": [
        "./libs/organization/application/src/index.ts"
      ],
      "@abms/organization-api": ["./libs/organization/api/src/index.ts"],
      "@abms/identity-domain": ["./libs/identity/domain/src/index.ts"],
      "@abms/identity-infrastructure": [
        "./libs/identity/infrastructure/src/index.ts"
      ],
      "@abms/identity-application": [
        "./libs/identity/application/src/index.ts"
      ],
      "@abms/identity-api": ["./libs/identity/api/src/index.ts"],
      "@abms/hr-domain": ["./libs/hr/domain/src/index.ts"],
      "@abms/hr-infrastructure": ["./libs/hr/infrastructure/src/index.ts"],
      "@abms/hr-application": ["./libs/hr/application/src/index.ts"],
      "@abms/hr-api": ["./libs/hr/api/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
