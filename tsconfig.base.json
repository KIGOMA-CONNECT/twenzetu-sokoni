{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "typeRoots": ["./node_modules/@types", "./types"],
    "types": ["node", "jest"],
    "paths": {
      "@afri-market/kernel": ["./libs/kernel/src/index.ts"],
      "@afri-market/core-config": ["./libs/core/config/src/index.ts"],
      "@afri-market/core-logger": ["./libs/core/logger/src/index.ts"],
      "@afri-market/core-http": ["./libs/core/http/src/index.ts"],
      "@afri-market/core-exceptions": ["./libs/core/exceptions/src/index.ts"],
      "@afri-market/core-security": ["./libs/core/security/src/index.ts"],
      "@afri-market/tenancy": ["./libs/tenancy/src/index.ts"],
      "@afri-market/database": ["./libs/database/src/index.ts"],
      "@afri-market/identity-domain": ["./libs/identity/domain/src/index.ts"],
      "@afri-market/identity-infrastructure": ["./libs/identity/infrastructure/src/index.ts"],
      "@afri-market/identity-application": ["./libs/identity/application/src/index.ts"],
      "@afri-market/identity-api": ["./libs/identity/api/src/index.ts"],
      "@afri-market/marketplace-domain": ["./libs/marketplace/domain/src/index.ts"],
      "@afri-market/marketplace-infrastructure": ["./libs/marketplace/infrastructure/src/index.ts"],
      "@afri-market/marketplace-application": ["./libs/marketplace/application/src/index.ts"],
      "@afri-market/marketplace-api": ["./libs/marketplace/api/src/index.ts"],
      "@afri-market/integrations": ["./libs/integrations/src/index.ts"],
      "@afri-market/ussd": ["./libs/ussd/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "**/__tests__/**", "**/*.spec.ts"]
}
