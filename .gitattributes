# Ensure shell scripts and Dockerfiles keep LF line endings (required on Linux servers)
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Android Gradle wrapper scripts keep LF
android/gradlew text eol=lf

# Binary files must never be touched by line-ending conversion
*.jar binary
*.png binary
*.jks binary
*.keystore binary
*.aab binary
*.apk binary

# Normalize everything else to LF in the repo
* text=auto
