{
  "name": "hr-offboarding-infrastructure",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/hr/offboarding/infrastructure/src",
  "projectType": "library",
  "tags": ["scope:hr", "type:infrastructure"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/hr/offboarding/infrastructure",
        "main": "libs/hr/offboarding/infrastructure/src/index.ts",
        "tsConfig": "libs/hr/offboarding/infrastructure/tsconfig.lib.json",
        "assets": []
      }
    },
    "test-integration": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/hr-offboarding-infrastructure-integration"],
      "options": {
        "jestConfig": "libs/hr/offboarding/infrastructure/jest.integration.config.cts",
        "runInBand": true
      }
    }
  }
}
