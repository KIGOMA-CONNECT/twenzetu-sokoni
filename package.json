{
  "name": "@afri-market/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build --all",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all",
    "serve": "nx run api:serve",
    "migration:generate": "cross-env TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:generate -d apps/api/src/composition/cli-data-source.ts",
    "migration:run": "cross-env TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:run -d apps/api/src/composition/cli-data-source.ts",
    "migration:revert": "cross-env TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:revert -d apps/api/src/composition/cli-data-source.ts",
    "db:setup": "npm run migration:run && npm run seed",
    "seed": "cross-env TS_NODE_PROJECT=tsconfig.cli.json ts-node apps/api/src/composition/seed.ts"
  },
  "private": true,
  "dependencies": {
    "@keyv/redis": "^5.1.6",
