# Copy this file to .env and adjust values for your machine. .env is
# read both by the NestJS app (AppConfigService) and by `docker compose`
# (compose auto-loads a .env file from this same directory).

# --- Application ---------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database (shared-schema, PostgreSQL Row-Level Security) -------------
# DB_HOST/DB_PORT are how the app reaches Postgres (the docker-compose
# service publishes DB_PORT on localhost).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abms
DB_SSL=false
DB_POOL_MAX=20

# Migration-owner role: runs migrations, owns all tables. Subject to RLS
# policies on DML once FORCE ROW LEVEL SECURITY is set, but not restricted
# from DDL. Never used by the running application.
DB_OWNER_USER=abms_owner
DB_OWNER_PASSWORD=abms_owner_dev_password

# Runtime role: used by the app's connection pool. Only has DML privileges
# (SELECT/INSERT/UPDATE/DELETE) on tables, never DDL, and is always subject
# to Row-Level Security.
DB_RUNTIME_USER=abms_runtime
DB_RUNTIME_PASSWORD=abms_runtime_dev_password

# Bootstrap superuser used ONLY by the postgres container's own init
# scripts to create the two roles above. Never used by the app or by
# TypeORM migrations.
DB_BOOTSTRAP_USER=postgres
DB_BOOTSTRAP_PASSWORD=postgres

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
