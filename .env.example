# ==============================================================================
# afriMarket — environment variables
# Copy to `.env` for local development, or `.env.production` (per prod compose
# `${VAR:?...}` required markers). NEVER commit real secrets.
# See .gitignore (`.env`, `.env.*`, `*.pem`, `*.key`, `sites/*.pem`, `.npmrc`,
# `secrets/` are ignored).
# ==============================================================================

# --- App ---
APP_ENV=development            # development | staging | production
APP_PORT=3000
APP_NAME=afriMarket
SWAGGER_ENABLED=true           # /docs served when APP_ENV != production and != 'false'

# --- Database (docker-compose.yml, local) ---
DB_PORT=5434                   # host port mapped to 5432 in the container
DB_NAME=afri_market
DB_BOOTSTRAP_USER=postgres
DB_BOOTSTRAP_PASSWORD=postgres            # REQUIRED in production (no default)
DB_OWNER_USER=afri_owner
DB_OWNER_PASSWORD=afri_owner_dev_password # REQUIRED in production
DB_RUNTIME_USER=afri_runtime
DB_RUNTIME_PASSWORD=afri_runtime_dev_password # REQUIRED in production

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=changeme                    # REQUIRED in production (no default)

# --- Auth / secrets (startup fail-fast in production) ---
JWT_SECRET=dev-jwt-secret-change-in-production # REQUIRED in production
JWT_EXPIRY=7d
METRICS_SECRET=dev-metrics-secret             # REQUIRED in production; used for /api/metrics
PAYMENT_CONFIRM_SECRET=dev-payment-secret     # REQUIRED in production
WEBHOOK_INTERNAL_SECRET=dev-webhook-secret    # REQUIRED in production

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5

# --- SMS (optional; provider selection per country) ---
# Preferred provider per country region: twilio | termii | africastalking
SMS_PROVIDER_DEFAULT=twilio
SMS_PROVIDER_TZ=termii
SMS_PROVIDER_NG=termii
SMS_DEFAULT_COUNTRY=TZ
# Africa's Talking
AT_API_KEY=
AT_USERNAME=sandbox                 # e.g. sandbox in sandbox mode; your real username in production
AT_SENDER_ID=afriMarket
AT_ENVIRONMENT=sandbox              # sandbox | production
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Termii
TERMII_API_KEY=

# --- CORS ---
CORS_ORIGINS=https://yourdomain.com

# --- Web Push (VAPID) ---
# Generate a keypair with: npx web-push generate-vapid-keys
# Required only for web push notifications; if empty, push is disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@afrimarket.co.tz

# --- M-PESA ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/api/webhooks/mpesa
MPESA_ENVIRONMENT=production   # sandbox | production

# --- AzamPay ---
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
AZAMPAY_CALLBACK_URL=https://yourdomain.com/api/webhooks/azampay
AZAMPAY_ENVIRONMENT=sandbox    # sandbox | production

# --- Monitoring (docker-compose.monitoring.yml) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme     # REQUIRED in production (no default)
GRAFANA_DOMAIN=localhost
GRAFANA_ROOT_URL=https://monitoring.localhost
